---
import { media } from '../data/media'

interface Props {
  title?: string
  subtitle?: string
}

const {
  title = 'NPO法人\n日本森林ボランティア協会へようこそ',
  subtitle = '森に入り、手を動かし、森を育てています'
} = Astro.props
---

<div class="bg-header relative" style={`background-image: url('${media.headerBg}')`}>
  <div class="absolute inset-0 z-10 bg-black/15"></div>
  <div class="relative z-20">
    <slot name="navigation" />
    <div class="container mx-auto px-4 py-32 text-center">
      <div class="inline-block text-left">
        <h1 class="mb-4 text-4xl font-bold text-white md:text-6xl">
          {title}
        </h1>
      </div>
      <p class="text-xl text-white">
        {subtitle}
      </p>
    </div>
  </div>
</div>

<style>
  .bg-header {
    background-size: cover;
    background-position: center;
    min-height: 400px;
  }
</style>

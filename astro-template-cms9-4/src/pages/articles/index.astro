---
import Layout from '../../layouts/Layout.astro'

interface Article {
  id: string
  slug: string
  title: string
  description?: string
  date?: string
  author?: string
  tags?: string[]
  draft?: boolean
}

let articles: Article[] = []
let error = ''

try {
  const response = await fetch(`${Astro.url.origin}/api/articles`)
  const data = await response.json()

  if (data.success) {
    articles = data.data
  } else {
    error = data.error || '記事の取得に失敗しました'
  }
} catch (e) {
  error = 'サーバーエラーが発生しました'
  console.error('Error fetching articles:', e)
}

// 日付でソート（新しい順）
articles.sort((a, b) => {
  if (!a.date || !b.date) return 0
  return new Date(b.date).getTime() - new Date(a.date).getTime()
})

function formatDate(dateString?: string): string {
  if (!dateString) return ''
  const date = new Date(dateString)
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  })
}
---

<Layout title="記事一覧" description="MDXで作成された記事の一覧ページです">
  <div class="mx-auto max-w-4xl">
    <h1 class="mb-8 text-3xl font-bold text-gray-900">記事一覧</h1>

    {
      error && (
        <div class="mb-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-red-700">
          {error}
        </div>
      )
    }

    {
      articles.length === 0 && !error && (
        <div class="rounded border border-gray-200 bg-gray-50 px-4 py-3 text-gray-700">
          記事が見つかりませんでした。
        </div>
      )
    }

    <div class="space-y-6">
      {
        articles.map((article) => (
          <article class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
            <h2 class="mb-2 text-xl font-semibold text-gray-900">
              <a
                href={`/articles/${article.slug}`}
                class="hover:text-primary-600 transition-colors"
              >
                {article.title}
              </a>
            </h2>

            {article.description && <p class="mb-3 text-gray-600">{article.description}</p>}

            <div class="flex flex-wrap items-center gap-4 text-base text-gray-500">
              {article.date && <time datetime={article.date}>📅 {formatDate(article.date)}</time>}

              {article.author && <span>✍️ {article.author}</span>}
            </div>

            {article.tags && article.tags.length > 0 && (
              <div class="mt-3 flex flex-wrap gap-2">
                {article.tags.map((tag) => (
                  <span class="bg-primary-100 text-primary-800 inline-block rounded-full px-2 py-1 text-sm">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</Layout>

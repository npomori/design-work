---
import Layout from '../../layouts/Layout.astro'
import WorkingMDXRenderer from '../../components/article/WorkingMDXRenderer.tsx'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  // APIエンドポイントから記事リストを取得してパスを生成
  try {
    // 開発環境での静的生成のため、直接コンテンツコレクションを使用
    const { getCollection } = await import('astro:content')
    const articles = await getCollection('articles')

    return articles
      .filter((article) => !article.data.draft)
      .map((article) => ({
        params: { slug: article.slug },
  // props は最小限（フェールバック用）のみ渡し、本文はAPIから取得
  props: { article: { id: article.id, slug: article.slug, data: article.data } }
      }))
  } catch (error) {
    console.error('Error generating static paths:', error)
    return []
  }
}

interface Article {
  id: string
  slug: string
  title: string
  description?: string
  date?: string
  author?: string
  tags?: string[]
  content: string
}

interface Props {
  article?: Pick<CollectionEntry<'articles'>, 'id' | 'slug' | 'data'>
}

const { slug } = Astro.params
const { article: propArticle } = Astro.props as Props
let article: Article | null = null
let error = ''

// まずはAPI一覧から対象記事を取得（要件: /api/articles 由来のMDX本文を使用）
try {
  const response = await fetch(`${Astro.url.origin}/api/articles`)
  const data = await response.json()

  if (data.success && Array.isArray(data.data)) {
    const found = data.data.find(
      (a: Article) => a.slug === slug || a.id === slug || a.id === `${slug}.mdx`
    )
    if (found) {
      article = found
    } else {
      error = '記事が見つかりませんでした'
    }
  } else {
    error = data.error || '記事の取得に失敗しました'
  }
} catch (e) {
  // フェールバック: ビルド時などAPIが利用不可な場合はコンテンツコレクションから最低限の情報を使用
  if (propArticle) {
    article = {
      id: propArticle.id,
      slug: propArticle.slug,
      title: propArticle.data.title,
      description: propArticle.data.description,
      date: propArticle.data.date?.toISOString(),
      author: propArticle.data.author,
      tags: propArticle.data.tags,
      content: '' // 本文は取得できないため空。クライアント側で非表示にされる
    }
  } else {
    error = 'サーバーエラーが発生しました'
  }
  console.error('Error fetching articles list:', e)
}

function formatDate(dateString?: string): string {
  if (!dateString) return ''
  const date = new Date(dateString)
  return date.toLocaleDateString('ja-JP', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  })
}

// 404の場合
if (!article && !error) {
  return Astro.redirect('/404')
}
---

<Layout title={article?.title || 'エラー'} description={article?.description}>
  <div class="mx-auto max-w-4xl">
    {
      error && (
        <div class="mb-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-red-700">
          {error}
        </div>
      )
    }

    {
      article && (
        <article class="prose prose-lg max-w-none">
          <div class="mb-8">
            <h1 class="mb-4 text-3xl font-bold text-gray-900">{article.title}</h1>

            <div class="mb-4 flex flex-wrap items-center gap-4 text-base text-gray-500">
              {article.date && <time datetime={article.date}>📅 {formatDate(article.date)}</time>}

              {article.author && <span>✍️ {article.author}</span>}
            </div>

            {article.tags && article.tags.length > 0 && (
              <div class="mb-6 flex flex-wrap gap-2">
                {article.tags.map((tag) => (
                  <span class="bg-primary-100 text-primary-800 inline-block rounded-full px-2 py-1 text-sm">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <div class="border-t border-gray-200 pt-8">
            <!-- WorkingMDXRendererを使用したクライアント側でのMDXレンダリング -->
            <WorkingMDXRenderer content={article.content} client:load />
          </div>
        </article>
      )
    }

    <div class="mt-12 border-t border-gray-200 pt-8">
      <a
        href="/articles"
        class="text-primary-600 hover:text-primary-800 inline-flex items-center transition-colors"
      >
        ← 記事一覧に戻る
      </a>
    </div>
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro'
import { newsItems, newsCategories as categories } from '../data/news'
---

<Layout title="お知らせ">
  <div class="mx-auto max-w-4xl">
    <!-- ヘッダーセクション -->
    <div class="mb-8">
      <h1 class="text-3xl font-bold">お知らせ</h1>
      <p class="text-lg text-gray-600">
        日本森林ボランティア協会からの重要な情報をお知らせします。
        活動予定、募集情報、事務局からの連絡事項などを掲載しています。
      </p>
    </div>

    <!-- カテゴリーフィルター -->
    <div class="mb-8">
      <div class="flex flex-wrap gap-2 justify-center">
        {categories.map((category) => (
          <button
            class="px-4 py-2 rounded-full bg-primary-100 text-primary-800 hover:bg-primary-200 transition-colors"
            data-category={category}
          >
            {category}
          </button>
        ))}
      </div>
    </div>

    <!-- お知らせ一覧 -->
    <div class="space-y-6">
      {newsItems.map((item) => (
        <article class="bg-white rounded-lg shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
          <div class="p-6">
            <!-- ヘッダー -->
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center space-x-3">
                <span class={`px-3 py-1 rounded-full text-sm font-semibold ${
                  item.priority === 'high' 
                    ? 'bg-red-100 text-red-800' 
                    : item.priority === 'medium'
                    ? 'bg-yellow-100 text-yellow-800'
                    : 'bg-gray-100 text-gray-800'
                }`}>
                  {item.category}
                </span>
                {item.priority === 'high' && (
                  <span class="bg-red-500 text-white px-2 py-1 rounded text-sm font-bold">
                    重要
                  </span>
                )}
              </div>
              <div class="flex items-center text-base text-gray-500">
                <i class="fas fa-calendar mr-1"></i>
                {new Date(item.date).toLocaleDateString('ja-JP')}
              </div>
            </div>

            <!-- タイトル -->
            <h2 class="text-xl font-bold text-gray-800 mb-3">
              {item.title}
            </h2>

            <!-- 内容 -->
            <p class="text-gray-600 mb-4 leading-relaxed">
              {item.content}
            </p>

            <!-- 添付ファイル -->
            {item.attachments.length > 0 && (
              <div class="mb-4">
                <h4 class="text-base font-semibold text-gray-700 mb-2">添付ファイル:</h4>
                <div class="flex flex-wrap gap-2">
                  {item.attachments.map((file) => (
                    <a
                      href="#"
                      class="inline-flex items-center px-3 py-1 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors text-base"
                    >
                      <i class="fas fa-file-alt mr-2"></i>
                      {file}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <!-- フッター -->
            <div class="flex items-center pt-4 border-t border-gray-100">
              <div class="flex items-center text-base text-gray-500">
                <i class="fas fa-user mr-2"></i>
                {item.author}
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- ページネーション -->
    <div class="flex justify-center mt-12">
      <nav class="flex items-center space-x-2">
        <button class="px-4 py-2 bg-gray-200 text-gray-600 rounded hover:bg-gray-300">
          <i class="fas fa-chevron-left"></i>
        </button>
        <button class="px-4 py-2 bg-primary-600 text-white rounded">1</button>
        <button class="px-4 py-2 bg-gray-200 text-gray-600 rounded hover:bg-gray-300">2</button>
        <button class="px-4 py-2 bg-gray-200 text-gray-600 rounded hover:bg-gray-300">3</button>
        <button class="px-4 py-2 bg-gray-200 text-gray-600 rounded hover:bg-gray-300">
          <i class="fas fa-chevron-right"></i>
        </button>
      </nav>
    </div>
  </div>
</Layout> 